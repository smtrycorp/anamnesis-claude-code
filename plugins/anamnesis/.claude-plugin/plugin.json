{
  "name": "anamnesis",
  "version": "0.4.4",
  "description": "Persistent memory for Claude Code: lifecycle hooks capture each session's conversation and recall relevant memories into every prompt. Per-user encrypted at rest, visible and deletable at anamnesis.smtry.ai/memory. Sign in with 'anamnesis-config' (OAuth 2.1 + PKCE).",
  "author": {
    "name": "smtry.ai",
    "url": "https://anamnesis.smtry.ai"
  },
  "homepage": "https://anamnesis.smtry.ai",
  "license": "MIT",
  "keywords": [
    "memory",
    "mcp",
    "hooks",
    "persistent",
    "encryption"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
